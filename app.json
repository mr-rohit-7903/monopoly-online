{
  "expo": {
    "name": "Monopoly Banking",
    "slug": "monopoly-banking",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.monopoly.banking",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monopoly.banking"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableSeparateBuildPerCPUArchitecture": true,
            "enableProguardInReleaseBuilds": true
          }
        }
      ]
    ],
    "scheme": "monopoly-banking"
  }
}
